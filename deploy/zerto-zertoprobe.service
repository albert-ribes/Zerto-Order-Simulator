[Unit]
Description=Zerto Probe — Zerto API aggregator
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/zerto/observability/zerto-probe
ExecStart=/opt/zerto/observability/zerto-probe/.venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
