server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # BACKEND_URL s'injecta per env var en arrencar el contenidor.
    # Es substitueix via envsubst (nginx:alpine template processing).
    # Usar variable nginx evita que nginx intenti resoldre el nom al arrancar.
    set $be_upstream ${BACKEND_URL};

    location ~* \.(js|css)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires 0;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $be_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 2s;
        proxy_read_timeout    10s;
    }
}
