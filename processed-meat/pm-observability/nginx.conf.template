server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    location ~* \.(js|css)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires 0;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        rewrite            ^/api/(.*)$ /$1 break;
        proxy_pass         ${BACKEND_URL};
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_connect_timeout 2s;
        proxy_read_timeout    10s;
    }

    location ^~ /check/frontend/ {
        rewrite            ^/check/frontend/(.*)$ /$1 break;
        proxy_pass         ${FRONTEND_URL};
        proxy_set_header   Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout    5s;
    }

    location ^~ /check/db/ {
        rewrite            ^/check/db/(.*)$ /$1 break;
        proxy_pass         ${DBPROBE_URL};
        proxy_set_header   Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout    5s;
    }

    location ^~ /check/frontend-sys/ {
        rewrite            ^/check/frontend-sys/(.*)$ /$1 break;
        proxy_pass         ${SYSPROBE_FE_URL};
        proxy_set_header   Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout    5s;
    }

    location ^~ /check/db-sys/ {
        rewrite            ^/check/db-sys/(.*)$ /$1 break;
        proxy_pass         ${SYSPROBE_DB_URL};
        proxy_set_header   Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout    5s;
    }

    location ^~ /check/zerto/ {
        rewrite            ^/check/zerto/(.*)$ /$1 break;
        proxy_pass         ${ZERTOPROBE_URL};
        proxy_set_header   Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout    20s;
    }
}
